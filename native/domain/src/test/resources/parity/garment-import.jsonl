{"name":"img tags, lazy attributes and srcset","html":"<html><body>\n        <img src=\"hero.jpg\" />\n        <img data-src=\"/lazy.jpeg\" />\n        <img data-original=\"../up.png\" data-zoom=\"zoomed.webp\" />\n        <img srcset=\"small.jpg 200w, big.jpg 1200w, mid.jpg 600w\" />\n        <img data-srcset=\"a.jpg 100w, b.jpg 900w\" />\n        <img src=\"/logo/brand.svg\" />\n        <img src=\"/img/logo-header.png\" />\n        <img src=\"/favicon.ico\" />\n        <img src=\"/sprite.png\" />\n        <img src=\"/avatars/user.jpg\" />\n        <img src=\"/placeholder.png\" />\n        <img src=\"data:image/png;base64,AAA\" />\n        <img src=\"/notes.pdf\" />\n        <img src=\"http://192.168.1.1/cam.jpg\" />\n        <img src=\"/spaced%20name.jpg\" />\n        <img src=\"/no-extension\" />\n      </body></html>","url":"https://example.com/shop/p","result":{"ok":true,"data":{"sourceUrl":"https://example.com/shop/p","title":null,"brand":"Example","imageUrls":["https://example.com/shop/hero.jpg","https://example.com/lazy.jpeg","https://example.com/up.png","https://example.com/shop/zoomed.webp","https://example.com/shop/big.jpg","https://example.com/shop/b.jpg","http://192.168.1.1/cam.jpg","https://example.com/spaced%20name.jpg","https://example.com/no-extension"],"warnings":[],"parser":"html-images"}}}
