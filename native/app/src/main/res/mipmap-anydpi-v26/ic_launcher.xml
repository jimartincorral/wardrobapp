<?xml version="1.0" encoding="utf-8" ?>
<!--
    The adaptive icon, from Android 8 onwards: two layers the launcher masks into
    whatever shape it uses, and a third the system may repaint in its own colours.

    `mipmap-anydpi-v26` rather than a density folder because the layers are vectors
    and a vector has no density. The raster icons alongside are for Android 7,
    which this app still supports and which has no adaptive icons at all.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
