# @tensorflow/tfjs-react-native@1.0.0 declares a peer dependency on
# @react-native-async-storage/async-storage@^1.13.0, but Expo SDK 55 requires
# 2.2.0. npm ci refuses the conflict outright, which breaks CI, and a fresh
# `npm install` fails the same way for anyone cloning the repo.
#
# The mismatch is inert here: async-storage is referenced only by tfjs's
# async_storage_io module, behind a lazy require() inside a function, and this
# app imports @tensorflow/tfjs-react-native purely for its platform-adapter
# side effect -- it never calls asyncStorageIO. Local installs have already
# been resolving this way via a one-off --legacy-peer-deps flag; this just
# makes that reproducible instead of relying on how someone happened to type
# the install command.
legacy-peer-deps=true
