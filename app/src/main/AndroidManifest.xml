<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wardrobapp">

        <!--
            Ask Play Services to fetch the subject-segmentation model at install
            time rather than on first use. The React Native app declares nothing
            like this and its on-demand download works, so this is an improvement
            rather than a prerequisite: it moves the wait off the first tap.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!--
            How the language choice survives a restart on Android 12 and lower.

            AppCompat reads this service's metadata to decide whether it owns
            locale storage; with autoStoreLocales true it persists the choice
            itself, so nothing here has to. On Android 13 and up the platform
            stores it instead, and the two stay in step — which is why the
            in-app picker and the system's own per-app language screen agree
            rather than being two settings for one thing.

            Disabled and unexported deliberately: it is a metadata holder that is
            never started.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            How a camera app is handed somewhere to write.

            Not exported and with no permission of its own: the grant travels with
            the intent, for one URI, and is revoked when the activity finishes.
            `android:authorities` is derived from the application id so the dev
            build and a future cutover build cannot collide on one device.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                URL import, the way the app that ships is reached: a
                `wardrobapp://...?importUrl=...` link. Kept identical so a QR code
                or a saved link that opens that app opens this one.

                Nothing is fetched on arrival. The address is shown with its host
                and waits for a tap, because a link can be opened by any web page,
                message or code — so it is not necessarily one the user chose, and
                a phone sits inside a home network.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wardrobapp" />
            </intent-filter>

            <!--
                The share sheet, which is how this is actually used: a product page
                open in a browser, shared to the app. `text/*` as well as
                `text/plain` because browsers disagree about which they send.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
